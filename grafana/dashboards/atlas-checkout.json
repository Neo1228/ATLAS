{
  "uid": "atlas-checkout-local",
  "title": "Atlas local checkout signals",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    { "id": 1, "title": "HTTP requests / second", "type": "timeseries", "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }, "targets": [{ "expr": "sum by (method, status) (rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[1m]))", "legendFormat": "{{method}} {{status}}", "refId": "A" }] },
    { "id": 2, "title": "HTTP latency p95", "type": "timeseries", "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }, "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[1m])))", "legendFormat": "{{uri}}", "refId": "A" }] },
    { "id": 3, "title": "JVM heap used", "type": "timeseries", "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 }, "targets": [{ "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "heap bytes", "refId": "A" }] },
    { "id": 4, "title": "Process CPU", "type": "timeseries", "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 }, "targets": [{ "expr": "process_cpu_usage", "legendFormat": "process CPU ratio", "refId": "A" }] },
    { "id": 5, "title": "PostgreSQL active connections", "type": "timeseries", "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 }, "targets": [{ "expr": "pg_stat_activity_count", "legendFormat": "{{datname}} / {{state}}", "refId": "A" }] },
    { "id": 6, "title": "PostgreSQL transaction rate", "type": "timeseries", "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 }, "targets": [{ "expr": "sum by (datname) (rate(pg_stat_database_xact_commit[1m]))", "legendFormat": "{{datname}} commits/s", "refId": "A" }] },
    { "id": 7, "title": "PostgreSQL deadlocks / second", "type": "timeseries", "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 }, "targets": [{ "expr": "sum by (datname) (rate(pg_stat_database_deadlocks[1m]))", "legendFormat": "{{datname}}", "refId": "A" }] }
  ]
}
