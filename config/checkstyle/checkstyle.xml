<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <module name="TreeWalker">
        <module name="RegexpSinglelineJava">
            <property name="format" value="^(?!\s*(?:package|import)\b).*\b[a-z_$][A-Za-z0-9_$]*(?:\.[a-z_$][A-Za-z0-9_$]*)*\.[A-Z][A-Za-z0-9_$]*(?:\.[A-Z][A-Za-z0-9_$]*)*"/>
            <property name="ignoreComments" value="true"/>
            <property name="message" value="Use an import; fully qualified class names are prohibited in code."/>
        </module>
    </module>
</module>
