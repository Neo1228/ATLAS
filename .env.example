ATLAS_PAYMENT_PROVIDER=disabled
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Optional Compose callback target for local PayPal Buyer approval. Keep the host port and public URL aligned.
# ATLAS_PAYMENT_RETURN_PORT=18080
# ATLAS_PUBLIC_BASE_URL=http://127.0.0.1:18080
# Full Sandbox capture requires a Sandbox Buyer. Approval URL is a one-time capability; only print in a private local terminal.
# Enable ATLAS_PAYMENT_PROVIDER=paypal only for an intentional Sandbox run.
# Export these values or pass --env-file .env.local; Compose does not load .env.local automatically.
# Keep credentials out of Git, command output, logs, and k6 summaries.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# BOK ECOS API key for the KRW/USD reference rate; set locally, never commit a key.
# BOK_ECOS_API_KEY=
# Without an ECOS key, a local Sandbox run can use the keyless ECB reference rate instead.
# ATLAS_EXCHANGE_RATE_PROVIDER=frankfurter
# 선택: 예약·확정·재입고 worker가 공유하는 poll 간격. 기본값은 PT1S.
# ATLAS_ORDER_INVENTORY_RESERVATION_RECOVERY_POLL_INTERVAL=PT1S
# 선택: 예약·확정·재입고 worker가 공유하는 poll당 최대 처리 건수. 기본값은 100.
# ATLAS_ORDER_INVENTORY_RESERVATION_RECOVERY_BATCH_SIZE=100
# K6_TEST_ACCOUNT_PASSWORD=
# Optional; generate locally with `openssl rand -base64 32`. Without it, a process-only key invalidates JWTs on restart.
# ATLAS_JWT_SIGNING_SECRET=
# 키가 없을 때 프로세스 임시 키를 허용(로컬 단일 인스턴스 전용). 기본값 false이면 키 없이 기동하지 않는다.
# ATLAS_JWT_ALLOW_EPHEMERAL_KEY=true
# ATLAS_JWT_ISSUER=http://127.0.0.1:8080
# ATLAS_JWT_AUDIENCE=atlas-api
# SMTP is required for signup verification and password recovery.
# SPRING_MAIL_HOST=
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# ATLAS_ACCOUNT_MAIL_FROM=
# ATLAS_ACCOUNT_MAIL_PUBLIC_BASE_URL=http://127.0.0.1:8080
# Durable delivery of verification/reset mail through account_notification_outbox (V9) and a retrying worker.
# On by default. Set to false only as a rollback switch: mail is then sent after commit on the request thread and is
# lost on crash or SMTP error (ADR-0102, EXP-113 C1/C3).
# ATLAS_ACCOUNT_NOTIFICATION_OUTBOX_ENABLED=true
# Generate a 32-byte key with `openssl rand -base64 32`; required for TOTP enrollment.
# ATLAS_ACCOUNT_MFA_ENCRYPTION_KEY=
# Shopping assistant and seller return review LLM (ADR-0109, ADR-0110, ADR-0114). Off by default. Any OpenAI-compatible
# /v1 endpoint works; a local Ollama needs no key (README "로컬 Qwen으로 쇼핑 비서 실행"). Never commit a real key.
# ATLAS_LLM_ENABLED=false
# ATLAS_LLM_BASE_URL=
# ATLAS_LLM_MODEL=
# ATLAS_LLM_API_KEY=
# A local model may need longer than the 30 s default per call on its first (model loading) request.
# ATLAS_LLM_READ_TIMEOUT=PT120S
# The return review layer has its own switch; enable it only for a model that passed the 60-case evaluation (EXP-122).
# ATLAS_ORDER_RETURN_RECOMMENDATION_LLM_REVIEW_ENABLED=false
# PayPal Balance report reconciliation is disabled by default. When enabled, use a dedicated operator account,
# a password of at least 32 characters, and TLS at the trusted ingress; redact Authorization from logs.
# ATLAS_SETTLEMENT_REPORT_OPERATOR_ENABLED=false
# ATLAS_SETTLEMENT_REPORT_OPERATOR_USERNAME=
# ATLAS_SETTLEMENT_REPORT_OPERATOR_PASSWORD=
# PayPal Payouts is Sandbox-only and disabled by default; use a dedicated Payouts-enabled Sandbox app.
# ATLAS_PAYPAL_PAYOUTS_ENABLED=false
# ATLAS_PAYPAL_PAYOUT_WORKER_ENABLED=false
# Generate an independent 32-byte key with `openssl rand -base64 32`; do not reuse JWT/MFA keys.
# ATLAS_PAYPAL_PAYOUT_RECIPIENT_ENCRYPTION_KEY=
# ATLAS_PAYPAL_PAYOUT_RECIPIENT_KEY_ID=active
# During first v1 rotation retain the old key as `legacy-v1=<base64>`; v2 uses `key-id=<base64>`, comma-separated.
# Keep every old decryption key until no outbox row can require it.
# ATLAS_PAYPAL_PAYOUT_RECIPIENT_DECRYPTION_KEYS=
# Payout operators are per-person accounts by default (identity=account, ADR-0092): grant `payout_operator_account`
# to registered accounts that have TOTP MFA enabled; see docs/operations-guide.md.
# ATLAS_SETTLEMENT_PAYOUT_OPERATOR_ENABLED=false
# Rollback only: identity=shared-credential restores the single shared Basic credential (no separation-of-duties rule)
# and then needs a dedicated username and a 32+ character password.
# ATLAS_SETTLEMENT_PAYOUT_OPERATOR_IDENTITY=account
# ATLAS_SETTLEMENT_PAYOUT_OPERATOR_USERNAME=
# ATLAS_SETTLEMENT_PAYOUT_OPERATOR_PASSWORD=