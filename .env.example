ATLAS_PAYMENT_PROVIDER=disabled
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Optional Compose callback target for local PayPal Buyer approval. Keep the host port and public URL aligned.
# ATLAS_PAYMENT_RETURN_PORT=18080
# ATLAS_PUBLIC_BASE_URL=http://127.0.0.1:18080
# Full Sandbox capture requires a Sandbox Buyer. Approval URL is a one-time capability; only print in a private local terminal.
# Enable ATLAS_PAYMENT_PROVIDER=paypal only for an intentional Sandbox run.
# Export these values or pass --env-file .env.local; Compose does not load .env.local automatically.
# Keep credentials out of Git, command output, logs, and k6 summaries.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# BOK ECOS API key for the KRW/USD reference rate; set locally, never commit a key.
# BOK_ECOS_API_KEY=
# K6_TEST_ACCOUNT_PASSWORD=
# Optional; generate locally with `openssl rand -base64 32`. Without it, a process-only key invalidates JWTs on restart.
# ATLAS_JWT_SIGNING_SECRET=
# ATLAS_JWT_ISSUER=http://127.0.0.1:8080
# ATLAS_JWT_AUDIENCE=atlas-api
