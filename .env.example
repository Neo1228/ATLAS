ATLAS_PAYMENT_PROVIDER=paypal
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Development Sandbox only. Local values stay in ignored `.env.local`; never commit or log them.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# Optional; generate locally with `openssl rand -base64 32`. Without it, a process-only key invalidates JWTs on restart.
# ATLAS_JWT_SIGNING_SECRET=
# ATLAS_JWT_ISSUER=http://127.0.0.1:8080
# ATLAS_JWT_AUDIENCE=atlas-api
